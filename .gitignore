# 1. Byte-compiled / Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 2. Virtual Environments
venv/
.venv/
env/
ENV/

# 3. Environment & Security Secrets
.env
.env.local
*.env
!.env.example

# 4. Database (Vector DB & BM25 index - sinh tự động khi nạp)
vector_db/
database/*
!database/doc.md

# 5. Backup Code & Logs
backup_code/
logs/*
!logs/doc.md
*.log

# 6. IDE & OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# 7. Heavy Data files (Tránh đẩy hàng trăm MB tài liệu PDF lên GitHub)
data/*

# 8. Explicitly track metadata and benchmark test sets
!data/doc.md
!data/eval_data/
data/eval_data/**/*.jsonl
data/eval_data/**/eval_results_*.json

# 9. Tài liệu ngữ cảnh / hướng dẫn AI agent cá nhân (Module Ingestion)
src/ingestion/contexts/
src/ingestion/AGENTS.md
contexts/
AGENTS.md

# 10. Lockfile & cấu hình uv cục bộ (repo dùng requirements.txt)
uv.lock
pyproject.toml
.python-version