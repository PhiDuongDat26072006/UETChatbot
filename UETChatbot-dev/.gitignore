# 1. Byte-compiled / Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 2. Virtual Environments
venv/
.venv/
env/
ENV/

# 3. Environment & Security Secrets
.env
.env.local
*.env
!.env.example

# 4. Vector Database (Local SQLite & HNSW index - sinh tự động khi nạp)
vector_db/

# 5. Backup Code & Logs
backup_code/
logs/*
!logs/doc.md
*.log

# 6. IDE & OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# 7. Heavy Data files (Tránh đẩy hàng trăm MB tài liệu PDF lên GitHub)
data/*

# 8. Explicitly track metadata and benchmark test sets
!data/doc.md