# Khóa API của Google Gemini (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY= điền api_key ở đây

# Cấu hình Web Server Local
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
