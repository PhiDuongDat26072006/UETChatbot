# =========================================================================
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Hãy copy file này thành .env và điền thông tin thực tế:
#   cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
# DANH SÁCH API KEY GOOGLE GEMINI (Tự động chuyển sang key khác khi hết hạn mức)
# Khai báo danh sách các key ngăn cách bởi dấu phẩy:
# -------------------------------------------------------------------------
GEMINI_API_KEYS=key_thu_nhat,key_thu_hai_du_phong,key_thu_ba_du_phong

# Hoặc có thể khai báo một key duy nhất:
# GEMINI_API_KEY=key_duy_nhat

# Cấu hình Web Server Local
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
