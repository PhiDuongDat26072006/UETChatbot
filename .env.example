# =========================================================================
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Hãy copy file này thành .env và điền thông tin thực tế:
#   cp .env.example .env
# =========================================================================

# Khóa API chính của Google Gemini (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=điền_api_key_chính_ở_đây

# Khóa API dự phòng (Hệ thống tự động chuyển sang khi khóa trước hết hạn mức / 429 Quota Exceeded)
# Bạn có thể dùng tài khoản Google thứ 2 để tạo key dự phòng:
GEMINI_API_KEY_2=điền_api_key_dự_phòng_2_ở_đây
# GEMINI_API_KEY_3=điền_api_key_dự_phòng_3_ở_đây

# Hoặc khai báo gộp nhiều key cách nhau bởi dấu phẩy:
# GEMINI_API_KEYS=key1,key2,key3

# Cấu hình Web Server Local
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
