# =========================================================================
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Hãy copy file này thành .env và điền thông tin thực tế:
#   cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
# DANH SÁCH API KEY GOOGLE GEMINI (Hỗ trợ tự động chuyển key khi hết hạn mức)
# Bạn có thể cấu hình danh sách theo 1 trong 2 kiểu dưới đây trong file .env:
# -------------------------------------------------------------------------

# KIỂU 1: Đánh số thứ tự từng dòng (Khuyên dùng - Rất dễ nhìn và thêm mới)
GEMINI_API_KEY=điền_api_key_chính_ở_đây
GEMINI_API_KEY_2=điền_api_key_dự_phòng_2_ở_đây
# GEMINI_API_KEY_3=điền_api_key_dự_phòng_3_ở_đây
# GEMINI_API_KEY_4=điền_api_key_dự_phòng_4_ở_đây

# KIỂU 2: Khai báo gộp danh sách (phân tách bởi dấu phẩy hoặc xuống dòng)
# GEMINI_API_KEYS=key1,key2,key3

# Cấu hình Web Server Local
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
