# -------------------------------------------------------------------------
# DANH SÁCH API KEY GOOGLE GEMINI (Tự động chuyển sang key khác khi hết hạn mức)
# Khai báo mỗi key trên một dòng trong cặp dấu ngoặc kép "..." (rất tiện copy-paste):
# -------------------------------------------------------------------------
GEMINI_API_KEYS="
AIzaSy...key_chinh_1
AIzaSy...key_du_phong_2
AIzaSy...key_du_phong_3
"

# Cấu hình Web Server Local
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
