{
  "dataset_name": "UET Retrieval Evaluation Dataset",
  "version": "1.0.0",
  "created_date": "2026-10-05",
  "description": "Bộ dữ liệu đánh giá hiệu quả truy xuất (retrieval) cho UET RAG Chatbot. Bao gồm các câu hỏi đa dạng về chủ đề, độ khó, và phong cách hỏi.",
  "total_queries": 50,
  "total_corpus_documents": 3244,
  "query_types": {
    "factoid": 20,
    "list": 12,
    "multi_hop": 3,
    "comparison": 3,
    "procedure": 4,
    "aggregation": 1,
    "informal": 4,
    "out_of_domain": 3
  },
  "difficulty_distribution": {
    "easy": 11,
    "medium": 31,
    "hard": 8
  },
  "category_coverage": [
    "QUY_CHE_BIEU_MAU",
    "DAO_TAO",
    "CAN_BO_GIANG_VIEN",
    "TUYEN_SINH",
    "TIN_TUC_SU_KIEN",
    "NGHIEN_CUU_HOP_TAC"
  ],
  "unit_coverage": [
    "UET",
    "FIT",
    "FET",
    "FAT",
    "FCE",
    "FEMA",
    "FEPN",
    "SAE",
    "IAI"
  ],
  "files": {
    "queries": "retrieval_eval_queries.json",
    "qrels": "retrieval_eval_qrels.json",
    "corpus": "retrieval_eval_corpus.jsonl"
  },
  "metrics_to_evaluate": [
    "Precision@K (K=1,3,5,10)",
    "Recall@K (K=1,3,5,10,20)",
    "NDCG@K (K=3,5,10)",
    "MRR (Mean Reciprocal Rank)",
    "MAP (Mean Average Precision)",
    "Hit Rate@K"
  ],
  "relevance_scale": {
    "0": "Not relevant",
    "1": "Partially relevant - contains some related information",
    "2": "Highly relevant - directly answers the query"
  }
}